# Salin file ini menjadi `.env` lalu sesuaikan nilainya. Jangan pernah commit `.env`.

# Path database SQLite (relatif root repo bila diawali `backend/`).
DATABASE_URL=backend/data/karyawanku.db

# Rahasia penandatanganan JWT — WAJIB diisi, minimal 32 karakter.
# Server menolak start bila kosong atau lebih pendek dari 32 karakter.
# Rotasi nilai ini membatalkan SEMUA token yang masih berlaku (semua user harus login ulang).
# Contoh generate: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=ganti-dengan-rahasia-panjang-acak-minimal-32-karakter

# Port HTTP API.
PORT=3001

# Direktori penyimpanan PDF slip gaji (relatif CWD).
PAYSLIP_DIR=data/payslips

# Umur access token (detik). Default 1 jam (3600).
ACCESS_TOKEN_TTL_SECONDS=3600

# Umur refresh token / sesi (detik). Default 7 hari (604800).
REFRESH_TOKEN_TTL_SECONDS=604800

# Daftar origin yang diizinkan untuk CORS, dipisahkan koma tanpa spasi.
# Kosongkan / hapus untuk memakai default http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Rate limit POST /auth/sign-in per IP (default: 5 percobaan per 60 detik).
RATE_LIMIT_SIGNIN_MAX=5
RATE_LIMIT_SIGNIN_WINDOW_MS=60000

# Rate limit POST /auth/sign-up per IP (default: 3 percobaan per 60 detik).
RATE_LIMIT_SIGNUP_MAX=3
RATE_LIMIT_SIGNUP_WINDOW_MS=60000

# Batas ukuran body JSON (byte). Default 1 MB (1048576).
BODY_JSON_LIMIT=1048576

# Batas ukuran body multipart / upload (byte). Default 10 MB (10485760).
BODY_MULTIPART_LIMIT=10485760

# Jalankan migrasi skema otomatis saat boot. Default off — migrasi dilakukan
# eksplisit via `npm run db:migrate`. Set 1 hanya untuk dev/test convenience.
MIGRATE_ON_BOOT=0