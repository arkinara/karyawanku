    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
