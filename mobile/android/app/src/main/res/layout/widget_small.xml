<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket #74 — KaryawanKu widget, 2x2 (small). Header hidden; shift label +
     time range + status chip + action pill. The root container carries the
     open-app tap; the pill carries the clock action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_shift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/kk_on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Shift Pagi" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/kk_on_surface_variant"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="07:00 – 15:00" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/widget_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_neutral"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/kk_on_surface_variant"
            android:textSize="10sp"
            tools:text="Belum Clock In" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/kk_on_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Clock In" />
    </LinearLayout>
</LinearLayout>