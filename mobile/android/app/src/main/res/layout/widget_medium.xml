<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket #74 — KaryawanKu widget, 4x2 / 4x4 (medium). Business-name header
     (12sp) + shift label + time range + status chip + action pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/kk_on_surface_variant"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Warung Kopi Nusantara" />

    <TextView
        android:id="@+id/widget_shift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/kk_on_surface"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Shift Pagi" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/kk_on_surface_variant"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="07:00 – 15:00" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/widget_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_neutral"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="@color/kk_on_surface_variant"
            android:textSize="11sp"
            tools:text="Belum Clock In" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_bg"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/kk_on_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Clock In" />
    </LinearLayout>
</LinearLayout>