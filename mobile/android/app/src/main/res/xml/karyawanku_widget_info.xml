<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket #74 — KaryawanKu AppWidget provider info. Sizing covers 2x2
     (small layout) and 4x2 / 4x4 (medium layout); the provider picks the
     layout per widget instance by its reported min size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="410dp"
    android:maxResizeHeight="410dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_small"
    android:previewLayout="@layout/widget_small"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />